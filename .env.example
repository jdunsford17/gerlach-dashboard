# Use the exact address browsers will use, without a trailing slash.
STATION_ORIGIN=http://localhost:3000
# Generate a unique password of at least 24 characters. Username is admin.
STATION_ADMIN_PASSWORD=
# Used for storing the CAD connection. Generate separately from the password.
DISPATCH_SESSION_KEY=
EDISPATCHES_BOARD_GUID=
# Generate unique secrets only for the integrations you use.
MONDAY_FLEET_WEBHOOK_KEY=
MONDAY_ANNOUNCEMENTS_WEBHOOK_KEY=
ELITE_EMAIL_IMPORT_TOKEN=
# Optional for native Node; Compose uses /app/data/station.sqlite.
# STATION_DB_PATH=./data/station.sqlite
